{
    "//": "EarthExplorer unified configuration file. Missing any field only degrades gracefully with a console warning; the program keeps running. Note that '=' inside a URL must be written as %3d (the option string is split on spaces).",
    "globe": {
        "orthophoto": "https://webst01.is.autonavi.com/appmaptile?style%3d6&x%3d{x}&y%3d{y}&z%3d{z}",
        "elevation": "",
        "ocean_mask": "",
        "skirt_ratio": 0.05,
        "elevation_scale": 1.0,
        "web_mercator": true,
        "origin_bottom_left": false
    },
    "city": {
        "enabled": false,
        "folder": ""
    },
    "ui": {
        "font": ""
    },
    "api_keys": {
        "//": "Data sources that require a credential go here; environment variables (e.g. EARTH_FIRMS_KEY) take priority",
        "firms": "",
        "deepseek": "",
        "gemini": ""
    },
    "ai": {
        "//": "AI assistant (multi-provider). enabled=false disables it completely; a provider without a key is disabled automatically. type supports openai_compatible (DeepSeek/Qwen/GLM/Kimi etc., just swap base_url+model) / gemini / fake (offline replay)",
        "enabled": true,
        "active": "deepseek",
        "max_rounds": 30,
        "system_prompt": "",
        "providers": {
            "deepseek": {
                "type": "openai_compatible",
                "base_url": "https://api.deepseek.com/v1",
                "model": "deepseek-chat",
                "key_env": "EARTH_DEEPSEEK_KEY",
                "key_config": "deepseek",
                "timeout_seconds": 60
            },
            "gemini": {
                "type": "gemini",
                "model": "gemini-2.5-flash",
                "key_env": "EARTH_GEMINI_KEY",
                "key_config": "gemini",
                "timeout_seconds": 60
            }
        }
    },
    "data_sources": [
        {
            "id": "gdacs",
            "type": "gdacs",
            "name": "Disaster Alerts (GDACS)",
            "group": "Live Data / Live",
            "subtitle": "GDACS - UN global disaster alerts",
            "url": "https://www.gdacs.org/gdacsapi/api/events/geteventlist/MAP",
            "refresh_seconds": 600,
            "timeout_seconds": 15,
            "lift_meters": 3000,
            "enabled": false,
            "key_env": "",
            "key_config": ""
        },
        {
            "id": "quakes",
            "type": "usgs",
            "name": "Earthquakes (USGS)",
            "group": "Live Data / Live",
            "subtitle": "USGS - M2.5+ earthquakes in the last 24 hours",
            "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson",
            "refresh_seconds": 300,
            "timeout_seconds": 15,
            "lift_meters": 3000,
            "enabled": false,
            "key_env": "",
            "key_config": ""
        },
        {
            "id": "eonet",
            "type": "eonet",
            "name": "Natural Events (NASA EONET)",
            "group": "Live Data / Live",
            "subtitle": "NASA EONET - active natural events",
            "url": "https://eonet.gsfc.nasa.gov/api/v3/events?status=open&limit=200",
            "refresh_seconds": 900,
            "timeout_seconds": 15,
            "lift_meters": 3000,
            "enabled": false,
            "key_env": "",
            "key_config": ""
        }
    ]
}
